# Sample .env file (do not commit)
# Server options
TALKREADY_HOST=127.0.0.1
TALKREADY_PORT=3737
# Data directory (Windows default uses %LOCALAPPDATA%\TalkReady)
# TALKREADY_DATA_DIR=C:\Path\To\Data
# Optional static assets directory
# TALKREADY_STATIC_DIR=./static

# Optional Cloudinary credentials for server-side asset uploads
# Copy values from your Cloudinary dashboard. Never commit backend/.env.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=
